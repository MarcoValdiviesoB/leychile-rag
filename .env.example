# Copiar a .env y completar
OPENAI_API_KEY=sk-...
# Neon Postgres con pgvector (connection string)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Modelo de embeddings y de chat
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Fuente LeyChile (puede requerir ajuste/credencial; ver src/leychile_rag/ingest.py)
LEYCHILE_XML_BASE=https://www.leychile.cl/Consulta/obtxml
